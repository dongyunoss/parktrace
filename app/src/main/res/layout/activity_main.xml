<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="28dp">

    <!-- Left: where the car is, what it costs, what you can do -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="36dp"
        android:paddingEnd="40dp"
        android:paddingBottom="36dp">

        <!-- Status chip. Also the hidden demo switch: a tap starts (or stops) the in-app demo -->
        <TextView
            android:id="@+id/phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:text="주행 중"
            android:textColor="@color/muted"
            android:textSize="22sp" />

        <!-- Floor above pillar: each on its own full-width line, as large as the card allows, no boxes -->
        <TextView
            android:id="@+id/floorCaption"
            style="@style/Caption"
            android:layout_marginTop="26dp"
            android:text="층" />

        <TextView
            android:id="@+id/floorValue"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:autoSizeMaxTextSize="170sp"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/fg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="18dp"
            android:background="@color/line" />

        <TextView
            android:id="@+id/spotCaption"
            style="@style/Caption"
            android:text="구역" />

        <TextView
            android:id="@+id/spotValue"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:autoSizeMaxTextSize="170sp"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/brand" />

        <!-- Which car park this is, and when the position was saved -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/subline"
                style="@style/Small"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- Guidance line: what the app has just done (e.g. "저장 완료: 지하 1층 C-15 구역"), shown for a few seconds -->
        <TextView
            android:id="@+id/guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_inner_bg"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:paddingEnd="28dp"
            android:paddingBottom="18dp"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:visibility="gone" />

        <!-- pushes the fee card to the bottom of the card -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/feeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_inner_bg"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="26dp"
            android:paddingEnd="28dp"
            android:paddingBottom="26dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Caption"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="주차 요금" />

                <TextView
                    android:id="@+id/feeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/ok"
                    android:textSize="46sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/feeBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="18dp"
                android:max="1000"
                android:progressDrawable="@drawable/fee_progress" />

            <TextView
                android:id="@+id/fee"
                style="@style/Small"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="32sp"
                android:layout_marginTop="18dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right: the 3D view fills the whole card -->
    <com.parktrace.ui.SceneView
        android:id="@+id/scene"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1" />
</LinearLayout>
