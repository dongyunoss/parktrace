<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive OS app -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- No CAMERA permission: camera recognition of pillar signs is a future-plan item.
         This build simulates the recognised text (sdk/SimulatedSignReader). -->

    <!-- Pleos Vehicle SDK: only "normal" protection-level permissions are used.
         (Telltales / parking-brake need PRIVATE_CAR_SAFETY = signature|privileged, so they are NOT used.) -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />   <!-- door lock / door open -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- trip distance, steering angle, brake pedal -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />   <!-- driver seat occupancy -->

    <!-- Pleos FusedLocation SDK (dangerous -> runtime request) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- Pleos NaviHelper SDK (address / destination name for the record) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- Pleos TextToSpeech SDK (ON_DEVICE mode): short spoken confirmation, no input needed from the driver -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Keep monitoring while another app (navigation) is in the foreground -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Auto launch on garage entry. Android blocks activity starts from the background unless the app may
         draw over other apps (granted by the user / appops); the full-screen-intent notification is the fallback. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <queries>
        <!-- the car's camera app: opened by its launcher entry while backing in -->
        <package android:name="ai.umos.car.evs" />
    </queries>

    <application
        android:name=".ParkTraceApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_parktrace"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParkTrace">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ParkingMonitorService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- adb-only test hook (DUMP permission = shell/system only): simulated garage entry in the background -->
        <receiver
            android:name=".service.DebugEntryReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.parktrace.action.SIM_GARAGE_ENTRY" />
                <action android:name="com.parktrace.action.SIM_SIGN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
